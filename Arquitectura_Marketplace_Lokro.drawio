                <mxCell id="geo_api" value="Browser Geolocation API&#xa;GPS nativo (useGeolocation)&#xa;Centra mapa en usuario" style="rounded=1;fillColor=#e8f5e9;strokeColor=#82b366;fontSize=9;" parent="maps_box" vertex="1">
                    <mxGeometry x="10" y="123" width="180" height="55" as="geometry"/>
