                <mxCell id="e2" value="Supabase JS SDK&#xa;REST + WebSockets" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#82b366;fontStyle=2;fontSize=9;" parent="1" source="frontend_box" target="supabase_box" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
