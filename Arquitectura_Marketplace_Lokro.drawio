                <mxCell id="e4" value="create-preference" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#00b1ea;fontStyle=2;fontSize=9;" parent="1" source="frontend_box" target="ext_mp" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e5" value="Tiles + Marcadores" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#82b366;fontStyle=2;fontSize=9;" parent="1" source="frontend_box" target="maps_box" edge="1">
