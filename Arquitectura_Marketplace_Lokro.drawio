                <!-- FLUJO PRINCIPAL -->
                <mxCell id="flow_box" value="Flujo Principal del Usuario" style="swimlane;startSize=28;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1680" y="840" width="200" height="330" as="geometry"/>
                </mxCell>
                <mxCell id="flow_detail" value="1. Registro / Login&#xa;   → Supabase Auth&#xa;   → handle_new_user trigger&#xa;&#xa;2. Busca proveedor&#xa;   → Mapa Mapbox + filtros&#xa;&#xa;3. Solicita servicio&#xa;   → service_requests INSERT&#xa;&#xa;4. Chat en tiempo real&#xa;   → Supabase Realtime&#xa;&#xa;5. Pago con Mercado Pago&#xa;   → create-preference&#xa;   → IPN webhook&#xa;&#xa;6. Tracking GPS proveedor&#xa;   → provider_locations RT" style="rounded=1;fillColor=#f3e8ff;strokeColor=#9673a6;fontSize=9;align=left;" parent="flow_box" vertex="1">
                    <mxGeometry x="10" y="35" width="180" height="280" as="geometry"/>
                </mxCell>

                <!-- EDGES -->
                <mxCell id="e1" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#d6b656;fontStyle=2;fontSize=9;" parent="1" source="spa_client" target="frontend_box" edge="1">
